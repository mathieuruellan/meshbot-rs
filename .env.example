# meshbot-rs runtime environment.
#
# Copy to .env on the host, fill in, and mount it read-only. Three jobs:
#   1. connection settings
#   2. where the action scripts live
#   3. the credentials an action's declared env allowlist passes through
#
# This file is gitignored and the repository is public. Nothing here belongs in
# a tracked file. `.env` is the single source for tokens — scripts read them
# from their environment, never from a hardcoded value.
#
# A value here is only visible to a script if its verb entry names it. The
# child process gets an emptied environment plus exactly those names, so a
# secret that no verb declares cannot leak into a script or that script's own
# children. See the `env` list in `config.example.yaml` and `scripts.example/README.md`.

# --- connection ---
MESHCORE_HOST=proxy
MESHCORE_PORT=5000

# --- webhook (off unless set) ---
#
# `host:port` for the HTTP listener, e.g. `0.0.0.0:8080`. Unset means no
# listener at all, which is the default and should stay that way unless a proxy
# is in front of it.
#
# The listener authenticates nothing. It is meant to sit behind a reverse proxy
# that terminates TLS and requires a client certificate, and nothing here should
# be published directly. It can only post on channels `bot.channels` declares.
MESHBOT_HTTP_ADDR=

# --- action scripts ---
# The allowlist directory. Every declared script name resolves inside it, flat:
# no subdirectories, and anything that resolves outside is refused. Missing at
# startup is a hard error, so a wrong mount fails loudly instead of turning
# every command into "action failed".
MESHBOT_SCRIPT_DIR=/data/meshcore/meshbot-rs/scripts

# --- Home Assistant: read states and call services ---
HA_URL=https://homeassistant.example.com
HA_TOKEN=replace-me

# --- Komodo: fleet health, so a reboot can be seen coming ---
KOMODO_URL=https://komodo.example.com
KOMODO_KEY=replace-me
KOMODO_SECRET=replace-me

# --- Proxmox VE: the only destructive action ---
#
# PVE_TOKEN_GUEST is the complete Authorization header value, built in the
# Proxmox UI rather than concatenated here:
#
#   PVEAPIToken=USER@REALM!tokenid=8f14e45f-ceea-467a-9d4f-1a2b3c4d5e6f
#
# It must carry VM.PowerMgmt on the guests it may reboot, and nothing more.
PVE_URL=https://pve.example.com:8006
PVE_NODE=pve
PVE_TOKEN_GUEST=replace-me

# The second gate on rebooting. The bot's 30s confirmation latch is the first.
# The verb entry declares this name, and the child's environment is otherwise
# empty, so it must be set here for `reboot` to run at all:
#   unset -> the action fails, naming this variable
#   0     -> dry run: the script reports what it would do and stops
#   1     -> reboots
# Nothing reboots until you set this deliberately, and dropping it to 0 is how
# you disarm.
PVE_ALLOW_REBOOT=0
