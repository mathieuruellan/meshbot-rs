# meshbot-rs runtime environment.
#
# Copy to .env on the host, fill in, and mount it read-only. Two jobs:
#   1. connection settings
#   2. the key/value pool that rules can match on and templates can interpolate
#
# A .env key is reserved in the message context: a mesh message carrying the
# same key will not match a rule that uses it. Keep names specific to avoid
# collisions with message keys.

# --- connection ---
MESHCORE_HOST=proxy
MESHCORE_PORT=5000

# --- secrets: referenced from actions as ${NAME} ---
# HA_URL=https://homeassistant.breizhbiniou.fr
# HA_TOKEN=replace-me

# --- action defaults ---
# ACTION_TIMEOUT_SECS=10
# MAX_REPLY_CHARS=200
